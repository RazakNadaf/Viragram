<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/iv_student_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/cd_author_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_avatar_1" />

    <LinearLayout
        android:id="@+id/layout_student_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_student_follow"
        app:layout_constraintStart_toEndOf="@id/iv_student_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_student_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Noor Fernandes" />

        <TextView
            android:id="@+id/tv_student_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/viragram_text_secondary"
            android:textSize="13sp"
            tools:text="noor.f" />

        <TextView
            android:id="@+id/tv_student_course"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/viragram_text_hint"
            android:textSize="11sp"
            tools:text="MSc Computer Science • 2nd Year" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_student_follow"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="0dp"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:text="@string/btn_follow"
        android:textAllCaps="false"
        android:textColor="@color/viragram_purple_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/viragram_purple_primary"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>