<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Ring + Avatar Container -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <View
            android:id="@+id/v_story_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_story_ring" />

        <ImageView
            android:id="@+id/iv_story_avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_story_avatar"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_avatar_1" />

        <ImageView
            android:id="@+id/iv_add_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/nav_create"
            android:padding="3dp"
            android:src="@drawable/ic_add_story"
            android:visibility="gone"
            app:tint="@color/white" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_story_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/viragram_text_primary"
        android:textSize="12sp"
        tools:text="College Fest" />

</LinearLayout>