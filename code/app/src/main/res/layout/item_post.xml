<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/viragram_surface_light"
    android:orientation="vertical">

    <!-- Header Row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_post_author_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/cd_author_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_avatar_1" />

        <LinearLayout
            android:id="@+id/layout_author_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_follow"
            app:layout_constraintStart_toEndOf="@id/iv_post_author_avatar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/viragram_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Rahul Patil" />

            <TextView
                android:id="@+id/tv_author_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/viragram_text_secondary"
                android:textSize="12sp"
                tools:text="MCA • 1st Year" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_follow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:text="@string/btn_follow"
            android:textAllCaps="false"
            android:textColor="@color/viragram_purple_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_post_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/viragram_purple_primary"
            app:strokeWidth="1dp" />

        <ImageView
            android:id="@+id/btn_post_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_post_options"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/viragram_text_primary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Post Image Area (4:5 Aspect Ratio) -->
    <ImageView
        android:id="@+id/iv_post_image"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@color/viragram_border"
        android:contentDescription="@string/cd_post_image"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_post_fest" />

    <!-- Action Bar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_like_post"
            android:padding="3dp"
            android:src="@drawable/ic_like_outline_24" />

        <ImageView
            android:id="@+id/btn_comment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_comment_post"
            android:padding="3dp"
            android:src="@drawable/ic_comment_24"
            app:tint="@color/viragram_text_primary" />

        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_share_post"
            android:padding="3dp"
            android:src="@drawable/ic_share_24"
            app:tint="@color/viragram_text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_bookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_save_post"
            android:padding="3dp"
            android:src="@drawable/ic_bookmark_24"
            app:tint="@color/viragram_text_primary" />

    </LinearLayout>

    <!-- Post Information Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/viragram_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="124 likes" />

        <TextView
            android:id="@+id/tv_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/viragram_text_primary"
            android:textSize="14sp"
            tools:text="Rahul Patil  Great day at the college fest! 🔥" />

        <TextView
            android:id="@+id/tv_view_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/viragram_text_secondary"
            android:textSize="13sp"
            tools:text="View all 18 comments" />

        <TextView
            android:id="@+id/tv_time_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/viragram_text_hint"
            android:textSize="11sp"
            tools:text="2 hours ago" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/viragram_bg_light" />

</LinearLayout>