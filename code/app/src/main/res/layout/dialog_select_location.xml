<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/viragram_surface_light"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Location"
        android:textColor="@color/viragram_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_locations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rb_loc_campus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="Goa University Campus"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_loc_auditorium"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Main Auditorium"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_loc_cs_dept"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Computer Science Department"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_loc_library"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Central University Library"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_loc_sports"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Campus Athletics Ground"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp" />

    </RadioGroup>

</LinearLayout>