<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_conversation_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Avatar + Online Indicator -->
    <FrameLayout
        android:id="@+id/layout_conversation_avatar_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_conversation_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_author_avatar"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_avatar_1" />

        <View
            android:id="@+id/v_online_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_dot"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Details Container -->
    <LinearLayout
        android:id="@+id/layout_conversation_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_meta_container"
        app:layout_constraintStart_toEndOf="@id/layout_conversation_avatar_container"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_conversation_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/viragram_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Rahul Patil" />

        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/viragram_text_secondary"
            android:textSize="13sp"
            tools:text="Are you coming to the event tomorrow?" />

    </LinearLayout>

    <!-- Timestamp & Unread Badge Column -->
    <LinearLayout
        android:id="@+id/layout_meta_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_conversation_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/viragram_text_hint"
            android:textSize="12sp"
            tools:text="2m" />

        <TextView
            android:id="@+id/tv_unread_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>