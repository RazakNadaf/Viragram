<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viragram_bg_light"
    android:fillViewport="true"
    tools:context=".activities.ProfileSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/viragram_surface_light"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_settings"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <ImageView
                    android:id="@+id/btn_settings_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@string/btn_back_to_login"
                    android:src="@drawable/ic_arrow_back_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="24dp"
                    android:text="Settings"
                    android:textColor="@color/viragram_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/viragram_border" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Settings Options List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/viragram_surface_light"
            android:orientation="vertical">

            <!-- Admin Portal (Visible only for College Admin / Club Admin) -->
            <TextView
                android:id="@+id/btn_setting_admin_portal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Admin Portal"
                android:textColor="@color/viragram_purple_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_school_24"
                app:drawableTint="@color/viragram_purple_primary"
                tools:visibility="visible" />

            <View
                android:id="@+id/divider_admin_portal"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Account -->
            <TextView
                android:id="@+id/btn_setting_account"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Account"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_person_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border" />

            <!-- Privacy -->
            <TextView
                android:id="@+id/btn_setting_privacy"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Privacy &amp; Security"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_lock_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border" />

            <!-- Notifications -->
            <TextView
                android:id="@+id/btn_setting_notifications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Notifications"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_notifications_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border" />

            <!-- Appearance -->
            <TextView
                android:id="@+id/btn_setting_appearance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Appearance"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_settings_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border" />

            <!-- Help & Support -->
            <TextView
                android:id="@+id/btn_setting_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Help &amp; Support"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_school_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/viragram_border" />

            <!-- About Viragram -->
            <TextView
                android:id="@+id/btn_setting_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="About Viragram"
                android:textColor="@color/viragram_text_primary"
                android:textSize="16sp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24"
                app:drawableStartCompat="@drawable/ic_badge_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/viragram_border" />

            <!-- Log Out -->
            <TextView
                android:id="@+id/btn_setting_logout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Log Out"
                android:textColor="@color/viragram_like_red"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_logout_24" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>