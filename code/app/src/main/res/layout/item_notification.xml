<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section Header (e.g. "Today", "This Week", "Earlier") -->
    <TextView
        android:id="@+id/tv_notification_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/viragram_bg_light"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/viragram_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Today"
        tools:visibility="visible" />

    <!-- Notification Item Container Row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_notification_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/viragram_surface_light"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Avatar Container + Type Badge Overlay -->
        <FrameLayout
            android:id="@+id/layout_avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_notification_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_author_avatar"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_avatar_1" />

            <ImageView
                android:id="@+id/iv_type_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/app_name"
                android:padding="3dp"
                android:src="@drawable/ic_like_filled_24"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Message Body + Time -->
        <LinearLayout
            android:id="@+id/layout_message_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_notification_thumbnail"
            app:layout_constraintStart_toEndOf="@id/layout_avatar_container"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_notification_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/viragram_text_primary"
                android:textSize="14sp"
                tools:text="Rahul Patil liked your post." />

            <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/viragram_text_secondary"
                android:textSize="12sp"
                tools:text="10m ago" />

        </LinearLayout>

        <!-- Optional Post Thumbnail -->
        <ImageView
            android:id="@+id/iv_notification_thumbnail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@color/viragram_border"
            android:contentDescription="@string/cd_post_image"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_unread_dot"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_post_fest" />

        <!-- Unread Dot Indicator -->
        <View
            android:id="@+id/v_unread_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_button_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/viragram_border" />

</LinearLayout>