<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viragram_bg_light"
    android:fillViewport="true"
    tools:context=".activities.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Back Button & Logo -->
        <ImageView
            android:id="@+id/iv_register_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_to_login"
            android:src="@drawable/ic_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/viragram_text_primary" />

        <ImageView
            android:id="@+id/iv_register_logo"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_viragram_logo"
            app:layout_constraintBottom_toBottomOf="@id/iv_register_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_register_back" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_register_form"
            style="@style/Viragram.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/iv_register_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_register_title"
                    style="@style/Viragram.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_register"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_register_subtitle"
                    style="@style/Viragram.Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/subtitle_register"
                    android:textSize="14sp" />

                <!-- Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_full_name"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_full_name"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Student ID -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_student_id"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_student_id"
                    app:startIconDrawable="@drawable/ic_badge_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_student_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- College Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_email"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_email"
                    app:startIconDrawable="@drawable/ic_email_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Course / Major -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_course"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_course"
                    app:startIconDrawable="@drawable/ic_school_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_course"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Academic Year -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_year"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_year"
                    app:startIconDrawable="@drawable/ic_calendar_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_password"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_confirm_password"
                    style="@style/Viragram.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_confirm_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock_24"
                    app:startIconTint="@color/viragram_purple_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/viragram_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Register Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_register_submit"
                    style="@style/Viragram.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_register" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Link back to Login -->
        <TextView
            android:id="@+id/btn_already_have_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/link_already_have_account"
            android:textColor="@color/viragram_purple_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_register_form" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>