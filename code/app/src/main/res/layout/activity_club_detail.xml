<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viragram_bg_light"
    android:fillViewport="true"
    tools:context=".activities.ClubDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/viragram_surface_light"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_club_detail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <ImageView
                    android:id="@+id/btn_club_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@string/btn_back_to_login"
                    android:src="@drawable/ic_arrow_back_24" />

                <TextView
                    android:id="@+id/tv_club_toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="24dp"
                    android:textColor="@color/viragram_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Computer Science Club" />

            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/viragram_border" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Club Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/viragram_surface_light"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_club_detail_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/app_name"
                tools:src="@drawable/ic_avatar_4" />

            <TextView
                android:id="@+id/tv_club_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/viragram_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Computer Science Club" />

            <TextView
                android:id="@+id/tv_club_detail_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/viragram_text_secondary"
                android:textSize="14sp"
                tools:text="Official student technology &amp; coding community at Goa University." />

            <TextView
                android:id="@+id/tv_club_detail_members"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/viragram_purple_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="128 Active Student Members" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_club_detail_follow"
                android:layout_width="200dp"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/viragram_purple_primary"
                android:text="@string/btn_follow"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/viragram_border" />

        <!-- Recent Club Activity Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="Recent Club Activity"
            android:textColor="@color/viragram_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Club Posts RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_club_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>