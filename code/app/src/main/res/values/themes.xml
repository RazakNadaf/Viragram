<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Viragram Application Theme -->
    <style name="Base.Theme.Viragram" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/viragram_purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/viragram_purple_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/viragram_surface_light</item>
        <item name="colorOnSurface">@color/viragram_text_primary</item>
        <item name="android:colorBackground">@color/viragram_bg_light</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:statusBarColor">@color/viragram_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/viragram_bg_light</item>
        <item name="android:navigationBarColor">@color/viragram_surface_light</item>

        <!-- Bottom Sheet Background -->
        <item name="bottomSheetDialogTheme">@style/ViragramBottomSheetDialog</item>
    </style>

    <style name="Theme.Viragram" parent="Base.Theme.Viragram" />

    <style name="ViragramBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ViragramBottomSheetStyle</item>
    </style>

    <style name="ViragramBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/viragram_surface_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Viragram.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Viragram.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>