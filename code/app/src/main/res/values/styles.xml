<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Viragram.Text.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/viragram_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Viragram.Text.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/viragram_text_secondary</item>
    </style>

    <style name="Viragram.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/viragram_text_primary</item>
    </style>

    <style name="Viragram.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/viragram_purple_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Viragram.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/viragram_purple_primary</item>
        <item name="android:textColor">@color/viragram_purple_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Viragram.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/viragram_surface_light</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Viragram.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/viragram_purple_primary</item>
        <item name="hintTextColor">@color/viragram_text_hint</item>
    </style>

    <style name="Viragram.BottomNav.Indicator" parent="">
        <item name="android:color">@color/viragram_bg_light</item>
    </style>
</resources>